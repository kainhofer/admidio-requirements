{
    "id": "requirements",
    "name": "PLG_REQUIREMENTS_NAME",
    "description": "PLG_REQUIREMENTS_DESCRIPTION",
    "version": "0.6.1",
    "author": "Reinhold Kainhofer",
    "url": "https://github.com/kainhofer/admidio-requirements/",
    "icon": "bi-clipboard-check",
    "requires": {
        "admidio": ">=6.0",
        "php": ">=8.2"
    },
    "autoload": {
        "AdmidioPlugin\\Requirements\\": "src/"
    },
    "preferences": {
        "section": "content_management",
        "sequence": 40
    },
    "settings": {
        "requirements_plugin_enabled": {
            "type": "enum",
            "default": "2",
            "values": {
                "0": "SYS_DISABLED",
                "2": "ORG_REGISTERED_USERS"
            },
            "label": "ORG_ACCESS_TO_PLUGIN",
            "description": "ORG_ACCESS_TO_PLUGIN_DESC"
        },
        "requirements_activity_owner_edit_policy": {
            "type": "enum",
            "default": "always",
            "values": {
                "always": "PLG_REQUIREMENTS_EDIT_POLICY_ALWAYS",
                "until_submitted": "PLG_REQUIREMENTS_EDIT_POLICY_UNTIL_SUBMITTED"
            },
            "label": "PLG_REQUIREMENTS_EDIT_POLICY",
            "description": "PLG_REQUIREMENTS_EDIT_POLICY_DESC"
        },
        "requirements_proration_basis_default": {
            "type": "enum",
            "default": "month",
            "values": {
                "month": "PLG_REQUIREMENTS_PRORATION_MONTH",
                "day": "PLG_REQUIREMENTS_PRORATION_DAY",
                "week": "PLG_REQUIREMENTS_PRORATION_WEEK"
            },
            "label": "PLG_REQUIREMENTS_PRORATION_DEFAULT",
            "description": "PLG_REQUIREMENTS_PRORATION_DEFAULT_DESC"
        },
        "requirements_files_enabled": {
            "type": "bool",
            "default": 0,
            "label": "PLG_REQUIREMENTS_FILES_ENABLED",
            "description": "PLG_REQUIREMENTS_FILES_ENABLED_DESC"
        },
        "requirements_files_max_count": {
            "type": "int",
            "default": 5,
            "min": 1,
            "max": 50,
            "step": 1,
            "label": "PLG_REQUIREMENTS_FILES_MAX_COUNT",
            "description": "PLG_REQUIREMENTS_FILES_MAX_COUNT_DESC"
        },
        "requirements_files_max_size": {
            "type": "int",
            "default": 10,
            "min": 1,
            "max": 100,
            "step": 1,
            "label": "PLG_REQUIREMENTS_FILES_MAX_SIZE",
            "description": "PLG_REQUIREMENTS_FILES_MAX_SIZE_DESC"
        },
        "requirements_files_allowed_types": {
            "type": "string",
            "default": "pdf,jpg,jpeg,png",
            "label": "PLG_REQUIREMENTS_FILES_ALLOWED_TYPES",
            "description": "PLG_REQUIREMENTS_FILES_ALLOWED_TYPES_DESC"
        },
        "requirements_files_total_quota": {
            "type": "int",
            "default": 0,
            "min": 0,
            "max": 100000,
            "step": 1,
            "label": "PLG_REQUIREMENTS_FILES_TOTAL_QUOTA",
            "description": "PLG_REQUIREMENTS_FILES_TOTAL_QUOTA_DESC"
        },
        "requirements_review_enabled": {
            "type": "bool",
            "default": 0,
            "label": "PLG_REQUIREMENTS_REVIEW_ENABLED",
            "description": "PLG_REQUIREMENTS_REVIEW_ENABLED_DESC"
        },
        "requirements_review_roles": {
            "type": "roles",
            "default": [],
            "label": "PLG_REQUIREMENTS_REVIEWER_ROLES",
            "description": "PLG_REQUIREMENTS_REVIEWER_ROLES_DESC"
        },
        "requirements_review_users": {
            "type": "string",
            "default": "",
            "label": "PLG_REQUIREMENTS_REVIEWER_USERS",
            "description": "PLG_REQUIREMENTS_REVIEWER_USERS_DESC"
        },
        "requirements_review_reviewer_choice": {
            "type": "enum",
            "default": "configured",
            "values": {
                "configured": "PLG_REQUIREMENTS_REVIEWER_CHOICE_CONFIGURED",
                "pick_configured": "PLG_REQUIREMENTS_REVIEWER_CHOICE_PICK_CONFIGURED",
                "any": "PLG_REQUIREMENTS_REVIEWER_CHOICE_ANY"
            },
            "label": "PLG_REQUIREMENTS_REVIEWER_CHOICE",
            "description": "PLG_REQUIREMENTS_REVIEWER_CHOICE_DESC"
        },
        "requirements_review_edit_during": {
            "type": "enum",
            "default": "locked",
            "values": {
                "locked": "PLG_REQUIREMENTS_REVIEW_EDIT_LOCKED",
                "allowed": "PLG_REQUIREMENTS_REVIEW_EDIT_ALLOWED"
            },
            "label": "PLG_REQUIREMENTS_REVIEW_EDIT_DURING",
            "description": "PLG_REQUIREMENTS_REVIEW_EDIT_DURING_DESC"
        },
        "requirements_review_edit_after": {
            "type": "enum",
            "default": "allowed",
            "values": {
                "allowed": "PLG_REQUIREMENTS_REVIEW_EDIT_ALLOWED",
                "locked": "PLG_REQUIREMENTS_REVIEW_EDIT_LOCKED"
            },
            "label": "PLG_REQUIREMENTS_REVIEW_EDIT_AFTER",
            "description": "PLG_REQUIREMENTS_REVIEW_EDIT_AFTER_DESC"
        },
        "requirements_review_notifications": {
            "type": "bool",
            "default": 1,
            "label": "PLG_REQUIREMENTS_REVIEW_NOTIFICATIONS",
            "description": "PLG_REQUIREMENTS_REVIEW_NOTIFICATIONS_DESC"
        },
        "requirements_overview_previous_years": {
            "type": "int",
            "default": 4,
            "min": 0,
            "max": 20,
            "step": 1,
            "label": "PLG_REQUIREMENTS_OVERVIEW_PREVIOUS_YEARS",
            "description": "PLG_REQUIREMENTS_OVERVIEW_PREVIOUS_YEARS_DESC"
        },
        "requirements_widget_enabled": {
            "type": "enum",
            "default": "2",
            "values": {
                "0": "SYS_DISABLED",
                "2": "ORG_ONLY_FOR_REGISTERED_USER"
            },
            "label": "PLG_REQUIREMENTS_WIDGET_ENABLED",
            "description": "PLG_REQUIREMENTS_WIDGET_ENABLED_DESC"
        },
        "requirements_widget_previous_periods": {
            "type": "int",
            "default": 1,
            "min": 0,
            "max": 10,
            "step": 1,
            "label": "PLG_REQUIREMENTS_WIDGET_PREVIOUS_PERIODS",
            "description": "PLG_REQUIREMENTS_WIDGET_PREVIOUS_PERIODS_DESC"
        },
        "requirements_overview_sequence": {
            "type": "integer",
            "default": 30
        }
    }
}
